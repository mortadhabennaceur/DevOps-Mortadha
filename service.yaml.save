apiVersion: v1
kind: Service
metadata:
  name: student-management-service
spec:
  type: NodePort  # Exposes the service on a node port (for local access)
  selector:
    app: student-management
  ports:
    - port: 8089  # Service port
      targetPort: 8089  # Pod port
      nodePort: 30080  # External port (choose between 30000-32767)
